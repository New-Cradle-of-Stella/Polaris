{"kind":"table","sheet":"API目录_v1","address":"A1:L16","rows":16,"cols":12,"values":[["Polaris 游戏 API 规范｜v1 三类 API 精简目录",null,null,null,null,null,null,null,null,null,null,null],["本表只保留三类 API 的必要定义；末尾仅用“功能说明”概括每个 API 的用途，不再保留优先级、风险、错误约定和备注。",null,null,null,null,null,null,null,null,null,null,null],["目录条目",207,"属性提取",63,"方法调用",90,"手动注册回调",54,"精简版｜末尾仅保留功能说明",null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null],["编号","子系统","API类型","公共API","公共签名","访问","内部类型","内部成员","映射规则","生命周期","线程","功能说明"],[1,"Loop","属性提取","PolarisAPI.Game.Loop.GameFrameCount","int GameFrameCount { get; }","只读","XX.IN","static int totalframe","原值投影；不换算时间单位","全局","主线程","读取游戏当前累计运行帧数。"],[2,"Loop","属性提取","PolarisAPI.Game.Loop.HasFocus","bool HasFocus { get; }","只读","XX.IN","static bool application_focus","原值投影","全局","主线程","判断游戏窗口当前是否获得输入焦点。"],[3,"Input","属性提取","PolarisAPI.Game.Input.MousePosition","GameVector2 MousePosition { get; }","只读","XX.IN","static Vector2 Mouse","仅将 Unity Vector2 投影为 GameVector2","全局","主线程","读取鼠标当前的屏幕坐标。"],[4,"Input","属性提取","PolarisAPI.Game.Input.MouseWheelDelta","GameVector2 MouseWheelDelta { get; }","只读","XX.IN","static Vector2 MouseWheel","仅做类型投影","全局","主线程","读取本帧鼠标滚轮的滚动量。"],[5,"Core","属性提取","PolarisAPI.Game.AssetLoadStage","int AssetLoadStage { get; }","只读","XX.MTRX","private static int loaded","公开原始加载阶段值，不改写其语义","全局","主线程","读取游戏资源当前的加载阶段。"],[6,"Audio","属性提取","PolarisAPI.Game.Audio.IsReady","bool IsReady { get; }","只读","XX.SND","static bool loaded","原属性投影","全局","主线程","判断音频系统是否已经初始化完成。"],[7,"World","属性提取","PolarisAPI.Game.World.MapKey","string? MapKey { get; }","只读","m2d.Map2d","string key","读取当前 Map2d 实例的 key","地图","主线程","读取当前地图的唯一键名。"],[8,"World","属性提取","PolarisAPI.Game.World.MapTime","float? MapTime { get; }","只读","m2d.Map2d","float floort","原值投影，单位保持为游戏帧时间","地图","主线程","读取当前地图累计运行的游戏时间。"],[9,"World","属性提取","PolarisAPI.Game.World.MoverCount","int? MoverCount { get; }","只读","m2d.Map2d","int count_movers { get; }","原属性投影","地图","主线程","读取当前地图中的移动对象数量。"],[10,