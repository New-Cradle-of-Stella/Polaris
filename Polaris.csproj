<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Polaris</AssemblyName>
    <Product>AIC-Polaris</Product>
    <Version>2.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>Polaris</RootNamespace>
    <!-- SDK 风格的类库项目默认不会把 PackageReference 解析出的依赖拷进 bin\ ——那是给
         "被别的项目引用"准备的 .deps.json，不是给"直接扔进插件目录跑起来"用的。BepInEx
         插件是后者：NVorbis 以及它拉进来的 System.Memory/System.Buffers 必须实际躺在
         Polaris.dll 旁边，Mono 才找得到，否则 Res\Loaders\AudioLoader.cs 的 .ogg 解码在
         加载时就会 FileNotFoundException。PolarisTools 的 VSIX 打包也是同样原因用了这个属性。 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    SDK 风格项目默认把仓库下所有 *.cs 都当成 Compile 项。工具与分析产物目录（outputs\、
    .codex-work\）里会出现第三方 .cs（例如 node-gyp 自带的 Find-VisualStudio.cs），
    被通配带进来就是一堆与 Polaris 无关的 CS0111/CS0579。这些目录不是源码，显式排除，
    而不是要求使用者删掉自己的工作目录。
  -->
  <ItemGroup>
    <Compile Remove="outputs\**\*.cs" />
    <Compile Remove=".codex-work\**\*.cs" />
    <None Remove="outputs\**" />
    <None Remove=".codex-work\**" />
  </ItemGroup>

  <!--
    Krafs.Publicizer 以 contentfile 的形式塞进来一份 IgnoresAccessChecksToAttribute 源码，
    而 BepInEx 6 依赖的 MonoMod.Utils 里已经公开了同名类型——两份同名类型让每次构建都报
    两条 CS0436。这里去掉 Publicizer 那一份，让 Publicizer 生成的
    [assembly: IgnoresAccessChecksTo(...)] 统一绑到 MonoMod.Utils 的那一个；
    运行时 BepInEx 本来就会加载 MonoMod.Utils，不需要额外分发。
    注意不能改 PublicizerRuntimeStrategies 来绕开：那会换掉整个访问检查策略，是运行时行为改动，
    不是消一条警告该付的代价。
  -->
  <Target Name="DropDuplicateIgnoresAccessChecksTo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="@(Compile)" Condition="'%(Filename)' == 'IgnoresAccessChecksToAttribute'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--
      刻意不引用 BepInEx.Analyzers：它是 BepInEx 5 时代的包，两条规则（BepInEx001 缺少
      [BepInPlugin]、BepInEx002 未继承 BaseUnityPlugin）都把基类名硬编码成
      `BepInEx.BaseUnityPlugin`。本项目用的是 BepInEx 6 的 `BepInEx.Unity.Mono.BaseUnityPlugin`，
      于是 BepInEx002 对 Plugin 类恒为假阳性——它已经继承了正确的基类，却永远满足不了这条规则。
      两条规则在这个项目里都不可能命中真问题，留着只是每次构建多两行噪音。
    -->
    <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
	<PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <!-- 纯 C# 同步 Vorbis 解码，用于 Res\Loaders\AudioLoader.cs 的 .ogg 支持。和 Newtonsoft.Json
         不同，游戏程序集里没有同名类型，不存在身份冲突，走普通 NuGet 引用即可，正常拷贝到
         插件输出目录。 -->
    <PackageReference Include="NVorbis" Version="0.10.*" />
  </ItemGroup>

  <!--
    只 Publicize 这两个：Polaris 对游戏内部结构（私有字段/方法、Harmony 补丁目标）的假设
    全部集中在 Polaris.API 与 Polaris.Patch 命名空间下，那是唯一需要看进游戏内部的地方。
    pixelliner 与 Newtonsoft.Json 刻意不 publicize——用到的成员（PxlCharacter/PxlsLoader/
    PxlPose/PxlSequence/PxlFrame 等，已用 ilspycmd 反编译核实）本来就全是 public，
    多 publicize 一个程序集就多一份需要跟着游戏版本更新的内部结构假设。
  -->
  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
    <Publicize Include="unsafeAssem" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- $(AicManagedDir) 见 Directory.Build.props。Private=false：这些都是游戏自带程序集，
         玩家的游戏安装里本来就有，不应该被拷进插件输出目录跟着一起分发——不加这个会连带
         把它们在 $(AicManagedDir) 里的全部传递依赖（Unity/Fusion/Photon 等一堆引擎 DLL）
         也当成 copy-local 一起拷过来。 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(AicManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="unsafeAssem">
      <HintPath>$(AicManagedDir)\unsafeAssem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏自带的 Better 容器库（BDic/NDic）。Map2d 的按 key 查表返回 XX.NDic&lt;Map2d&gt;，
         它的索引器签名里出现 better 的类型，所以引用它才能调用——见 Api\Game\PolarisGameAPI.cs
         的 World.ChangeMap。 -->
    <Reference Include="better">
      <HintPath>$(AicManagedDir)\better.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- PixelLiner 的 .pxls 运行时类型，见 Res\Pxls\。 -->
    <Reference Include="pixelliner">
      <HintPath>$(AicManagedDir)\pixelliner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 引用游戏自带的 13.0.2，不用 NuGet 包引入，避免程序集身份冲突；见 Res\Import\ImportMetaJson.cs。 -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(AicManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
